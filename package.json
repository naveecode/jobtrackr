{
  "name": "jobtrackr",
  "version": "1.0.0",
  "private": true,
  "description": "Job application tracker: kanban pipeline, notes, reminders, and funnel analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:demo": "cross-env NEXT_PUBLIC_DEMO=1 DEMO_EXPORT=1 next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/prepare-prisma.mjs && prisma generate --schema prisma/.generated/schema.prisma",
    "db:push": "node scripts/prepare-prisma.mjs && prisma db push --schema prisma/.generated/schema.prisma",
    "db:setup": "npm run db:generate && npm run db:push",
    "predev": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "pretest": "npm run db:generate",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^7.0.9",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^6.4.20",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
