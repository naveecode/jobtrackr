// Jobtrackr data model.
// Committed provider is sqlite. `npm run db:generate` copies this file to
// prisma/.generated/schema.prisma and switches the provider to postgresql
// when DATABASE_URL starts with postgres or PRISMA_PROVIDER=postgresql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Auth.js (https://authjs.dev/getting-started/adapters/prisma) ---

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  applications  Application[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Tracker ---

model Application {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  role      String
  location  String?
  url       String?
  salary    String?
  stage     Stage      @default(SAVED)
  source    String?
  appliedAt DateTime?
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  notes     Note[]
  reminders Reminder[]

  @@index([userId, stage])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Reminder {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  dueAt         DateTime
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

enum Stage {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}
