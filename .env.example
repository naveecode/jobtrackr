# SQLite file, resolved relative to prisma/.generated/schema.prisma
DATABASE_URL="file:./dev.db"

# openssl rand -base64 32
AUTH_SECRET="replace-me"

# GitHub OAuth app. Callback: {origin}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Magic link delivery. Leave EMAIL_SERVER empty in dev to print the link in the server log.
# Example: smtp://user:pass@smtp.resend.com:587
EMAIL_SERVER=""
EMAIL_FROM="Jobtrackr <noreply@example.com>"

# Set to 1 for the localStorage demo (no login). Pair with DEMO_EXPORT=1 for GitHub Pages.
NEXT_PUBLIC_DEMO="0"

# sqlite (default) or postgresql. Inferred from DATABASE_URL when unset.
PRISMA_PROVIDER="sqlite"
